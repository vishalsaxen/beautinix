rules_version = '2';

// Beautinix database rules. Publish them in the Firebase console:
// Firestore Database → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The admin is the verified Gmail account below.
    function isAdmin() { return signedIn() && request.auth.token.email == "vishalsaxen@gmail.com" && request.auth.token.email_verified == true; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function path(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function validImage(d, max) { return d is string && d.size() <= max && d.matches("data:image/jpeg;base64,.*"); }
    // Optional Google Maps and Instagram links; an empty string removes one.
    function validLinks(d) {
      return (!("maps" in d) || d.maps == "" || (d.maps is string && d.maps.size() <= 300
          && d.maps.matches("https://(maps[.]app[.]goo[.]gl|goo[.]gl/maps|(www[.])?google[.](com|co[.]in)/maps|maps[.]google[.](com|co[.]in))/[^ <>\"]*")))
        && (!("insta" in d) || d.insta == "" || (d.insta is string && d.insta.matches("https://www[.]instagram[.]com/[A-Za-z0-9_.]{1,30}")));
    }
    // A salon's rough position (about 1 km), used to show guests the nearest salons first.
    function validGeo(g) {
      return g is map && g.keys().hasOnly(["lat", "lng", "approx"])
        && g.lat is number && g.lat >= 6 && g.lat <= 38
        && g.lng is number && g.lng >= 68 && g.lng <= 98
        && g.approx is bool;
    }
    function validAvailability(a) { return a in ["available", "busy", "unavailable"]; }
    function validTerms(t) { return t.version is string && t.fee == 200 && t.acceptedAt == request.time; }
    function validDetails(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.person is string && d.person.size() > 0 && d.person.size() <= 80
        && d.wa.matches("[+]91 [0-9]{5} [0-9]{5}")
        && d.state is string && d.city is string && d.city.size() > 0
        && d.pin.matches("[1-9][0-9]{5}");
    }

    // Full salon details. Signed-in users only; signed-out guests see the listings below.
    match /salons/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // The owner edits their details, links, services and availability, and records agreeing to the terms.
        || (signedIn() && resource.data.ownerUid == request.auth.uid
            && changed().hasOnly(["name", "person", "wa", "state", "city", "pin", "services", "availability", "terms", "maps", "insta"])
            && validDetails(request.resource.data)
            && validLinks(request.resource.data)
            && request.resource.data.services is list
            && request.resource.data.services.size() <= 100
            && validAvailability(request.resource.data.availability)
            && (!changed().hasAny(["terms"]) || validTerms(request.resource.data.terms))
            // A new name must be written to the public listing in the same batch.
            && (!changed().hasAny(["name"]) || getAfter(path("listings", id)).data.name == request.resource.data.name))
        // The owner claims the salon with the unique code sent on WhatsApp.
        || (signedIn() && resource.data.ownerUid == null
            && request.auth.token.email == resource.data.email
            && changed().hasOnly(["ownerUid", "status", "claimCode", "terms"])
            && validTerms(request.resource.data.terms)
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status == "active"
            && get(path("invites", request.resource.data.claimCode)).data.salonId == id
            && get(path("invites", request.resource.data.claimCode)).data.used == false
            && getAfter(path("invites", request.resource.data.claimCode)).data.used == true);
    }

    // Public part of a salon: name, availability, photo thumbnail and rough position.
    match /listings/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && getAfter(path("salons", id)).data.ownerUid == request.auth.uid
            && changed().hasOnly(["availability", "active", "name", "thumb", "geo"])
            && request.resource.data.name == getAfter(path("salons", id)).data.name
            && validAvailability(request.resource.data.availability)
            && (!("thumb" in request.resource.data) || validImage(request.resource.data.thumb, 100000))
            && (!("geo" in request.resource.data) || validGeo(request.resource.data.geo)));
    }

    // The salon's one large photo; its thumbnail sits on the listing.
    match /photos/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (signedIn() && get(path("salons", id)).data.ownerUid == request.auth.uid
            && request.resource.data.keys().hasOnly(["image", "updatedAt"])
            && validImage(request.resource.data.image, 900000));
      allow delete: if isAdmin() || (signedIn() && get(path("salons", id)).data.ownerUid == request.auth.uid);
    }

    // Sign-up codes. Anyone holding a code can look it up; only the admin can list them.
    match /invites/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && request.auth.token.email == resource.data.email
            && changed().hasOnly(["used"])
            && request.resource.data.used == true);
    }

    // Guest accounts: each guest reads and writes only their own details.
    match /guests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "wa", "email", "createdAt"])
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid && changed().hasOnly(["name", "wa"]);
      allow delete: if isAdmin();
    }

    // Bookings: made by a guest, seen by that guest, the salon's owner and the admin.
    match /bookings/{id} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.guestUid == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.guestUid == request.auth.uid
        && exists(path("guests", request.auth.uid))
        && request.resource.data.ownerUid != null
        && get(path("salons", request.resource.data.salonId)).data.ownerUid == request.resource.data.ownerUid
        // Only salons marked Available take bookings.
        && get(path("salons", request.resource.data.salonId)).data.availability == "available";
      allow delete: if isAdmin();
    }
  }
}
